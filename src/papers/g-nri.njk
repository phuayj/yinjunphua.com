              {% endfor %}
            </tbody>
            <tfoot><tr><th scope="row">Mean ({{ gnri.benchmarks.length }})</th><td>—</td><td>{{ gnri.mean.nri.toFixed(1) }}</td><td>{{ gnri.mean.gnri.toFixed(1) }}</td><td>{{ gnri.mean.tree.toFixed(1) }}</td></tr></tfoot>
          </table>
        </div>
      </details>
    </div>
  </section>
